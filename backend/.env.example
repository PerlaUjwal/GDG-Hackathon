# ==============================================================================
# FoundersGate Backend Configuration
# ==============================================================================

PORT=5000
JWT_SECRET=foundersgate-super-secret-key-2026

# ==============================================================================
# REAL EMAIL DISPATCH CONFIGURATION (Optional)
# If left blank, FoundersGate uses live Ethereal test mail with instant previews!
# ==============================================================================

# Option 1: Gmail Service (Recommended for quick real email sending)
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASS=

# Option 2: Custom SMTP (SendGrid, Mailgun, Amazon SES, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sender address shown to recipients
EMAIL_FROM="FoundersGate Security" <no-reply@foundersgate.com>

# ==============================================================================
# REAL SMS DISPATCH CONFIGURATION (Optional)
# If left blank, FoundersGate dispatches verification codes to linked email!
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================================
# FIREBASE STUDIO / FIREBASE ADMIN SDK CONFIGURATION (Optional)
# If provided (or if backend/serviceAccountKey.json is placed), FoundersGate
# connects to Cloud Firestore and Firebase Auth directly!
# ==============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

