# ==============================================================================
# FoundersGate Frontend Configuration & Firebase Studio Setup
# ==============================================================================

# Get these keys from your Firebase Console / Firebase Studio:
# 1. Open https://console.firebase.google.com/
# 2. Select or Create your project (e.g. "FoundersGate")
# 3. Click Project Settings (⚙️ Gear Icon) -> General
# 4. Under "Your apps", click the Web icon (</>) to register a Web App
# 5. Copy the configuration values below into frontend/.env

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

